const fs = require('fs');
const path = require('path');
const http = require('http');
const readline = require('readline');

const SCHEDULE_PATH = path.join(__dirname, 'schedule.json');
const HISTORY_PATH = path.join(__dirname, 'study_history.json');

function loadSchedule() {
  try {
    const data = fs.readFileSync(SCHEDULE_PATH, 'utf-8');
    return JSON.parse(data);
  } catch (err) {
    console.error('Error loading schedule:', err.message);
    return [];
  }
}

function parseTimeToMinutes(timeStr) {
  const [hours, minutes] = timeStr.split(':').map(Number);
  return hours * 60 + minutes;
}

function getNowMinutes() {
  const now = new Date();
  return now.getHours() * 60 + now.getMinutes();
}

function formatMinutes(mins) {
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  const ampm = h >= 12 && h < 24 ? 'PM' : 'AM';
  const displayH = h % 12 === 0 ? 12 : h % 12;
  const displayM = m < 10 ? '0' + m : m;
  return `${displayH}:${displayM} ${ampm}`;
}

function getScheduleStatus() {
  const schedule = loadSchedule();
  const nowMins = getNowMinutes();
  const now = new Date();

  let currentItem = null;
  let nextItem = null;

  for (let i = 0; i < schedule.length; i++) {
    const item = schedule[i];
    const startM = parseTimeToMinutes(item.start);
    const endM = parseTimeToMinutes(item.end);

    if (nowMins >= startM && nowMins < endM) {
      currentItem = item;
      nextItem = schedule[i + 1] || schedule[0];
      break;
    }
  }

  if (!currentItem) {
    // Check if before first event or after last event
    for (let i = 0; i < schedule.length; i++) {
      const item = schedule[i];
      const startM = parseTimeToMinutes(item.start);
      if (nowMins < startM) {
        nextItem = item;
        break;
      }
    }
    if (!nextItem && schedule.length > 0) {
      nextItem = schedule[0]; // wraps to next day
    }
  }

  // Calculate critical transit countdowns
  // 7:20 AM: Leave for bus stop (440 mins)
  // 7:28 AM: Catch bus (448 mins)
  const leaveStopMins = 7 * 60 + 20;
  const catchBusMins = 7 * 60 + 28;

  const minsUntilLeave = leaveStopMins - nowMins;
  const minsUntilBus = catchBusMins - nowMins;

  return {
    currentTimeFormatted: formatMinutes(nowMins),
    currentTimeISO: now.toISOString(),
    nowMins,
    currentItem,
    nextItem,
    minsUntilLeave,
    minsUntilBus
  };
}

function printStatus() {
  const status = getScheduleStatus();
  console.log('\n======================================================');
  console.log('           🐘 APPU: DARSHAN\'S DAILY ASSISTANT        ');
  console.log('======================================================');
  console.log(`🕒 Current Time: ${status.currentTimeFormatted}`);

  if (status.minsUntilLeave > 0 && status.minsUntilLeave <= 60) {
    console.log(`\n🚨 TRANSIT ALERT:`);
    console.log(`   ⏳ Walk to Bus Stop in: ${status.minsUntilLeave} minutes (at 7:20 AM)`);
    console.log(`   🚌 Bus Arrives in:      ${status.minsUntilBus} minutes (at 7:28 AM SHARP)`);
  } else if (status.minsUntilBus >= 0 && status.minsUntilBus <= 8) {
    console.log(`\n🚨 CRITICAL ALERT: BUS IS COMING AT 7:28 AM! (${status.minsUntilBus}m left)`);
  }

  if (status.currentItem) {
    const endM = parseTimeToMinutes(status.currentItem.end);
    const remaining = endM - status.nowMins;
    console.log(`\n📍 CURRENT TASK:`);
    console.log(`   Task:      ${status.currentItem.title} [${status.currentItem.type.toUpperCase()}]`);
    console.log(`   Duration:  ${status.currentItem.start} - ${status.currentItem.end} (${remaining}m remaining)`);
    console.log(`   Guidance:  ${status.currentItem.description}`);
  } else {
    console.log(`\n📍 CURRENT TASK: Off-schedule free window`);
  }

  if (status.nextItem) {
    const startM = parseTimeToMinutes(status.nextItem.start);
    let until = startM - status.nowMins;
    if (until < 0) until += 24 * 60;
    console.log(`\n🔜 NEXT UP:`);
    console.log(`   Task:      ${status.nextItem.title}`);
    console.log(`   Starts At: ${status.nextItem.start} (in ${until} minutes)`);
    console.log(`   Details:   ${status.nextItem.description}`);
  }

  console.log('\n💡 Study Sessions Today:');
  console.log('   - 07:00 PM - 08:00 PM: Evening Study Session 1 (Recall & Concept Drill)');
  console.log('   - 09:30 PM - 12:00 AM: Night Deep Work Session (No distractions)');
  console.log('======================================================\n');
}

function watchMode() {
  console.clear();
  console.log('🐘 Appu Watch Monitor Started... (Press Ctrl+C to stop)');
  let lastNotifiedMins = -1;

  setInterval(() => {
    const now = new Date();
    const nowMins = now.getHours() * 60 + now.getMinutes();

    if (nowMins !== lastNotifiedMins) {
      lastNotifiedMins = nowMins;
      console.clear();
      printStatus();

      // Audio beeps for critical moments
      if (nowMins === 7 * 60 + 20) {
        process.stdout.write('\x07\x07\x07');
        console.log('\n⚠️🔔 7:20 AM ALERT: Darshan, LEAVE FOR THE BUS STOP RIGHT NOW!');
      } else if (nowMins === 7 * 60 + 27 || nowMins === 7 * 60 + 28) {
        process.stdout.write('\x07\x07\x07');
        console.log('\n🚌🔔 7:28 AM ALERT: THE BUS IS HERE! GET ON BOARD!');
      } else if (nowMins === 19 * 60) {
        process.stdout.write('\x07');
        console.log('\n📚🔔 7:00 PM ALERT: Evening Study Session 1 begins!');
      } else if (nowMins === 21 * 60 + 30) {
        process.stdout.write('\x07');
        console.log('\n🧠🔔 9:30 PM ALERT: Night Deep Work Session begins! Phone on silent.');
      }
    }
  }, 1000);
}

function studyMode(subjectArg) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  const subject = subjectArg || 'General Study / Problem Solving';
  console.log('\n======================================================');
  console.log(`🧠 APPU STUDY COACH: ${subject.toUpperCase()}`);
  console.log('======================================================');
  console.log('Target: Lock in 100% focus. Eliminate all notifications.\n');

  const startTime = new Date();
  rl.question('What specific subtopic or goal are you tackling in this session? ', (goal) => {
    console.log(`\n✅ Session started at ${startTime.toLocaleTimeString()}!`);
    console.log(`🎯 Target Goal: ${goal}`);
    console.log('Type "done" when you finish to log this session, or "quiz" to test yourself.\n');

    rl.on('line', (line) => {
      const input = line.trim().toLowerCase();
      if (input === 'done' || input === 'finish' || input === 'exit') {
        const endTime = new Date();
        const durationMins = Math.round((endTime - startTime) / (1000 * 60));
        
        let history = [];
        try {
          if (fs.existsSync(HISTORY_PATH)) {
            history = JSON.parse(fs.readFileSync(HISTORY_PATH, 'utf-8'));
          }
        } catch (e) {}

        const record = {
          date: new Date().toLocaleDateString(),
          startTime: startTime.toLocaleTimeString(),
          endTime: endTime.toLocaleTimeString(),
          durationMins,
          subject,
          goal
        };
        history.push(record);
        fs.writeFileSync(HISTORY_PATH, JSON.stringify(history, null, 2));

        console.log(`\n🎉 Great work, Darshan! You completed ${durationMins} minutes of study.`);
        console.log(`Logged to ${HISTORY_PATH}`);
        rl.close();
        process.exit(0);
      } else if (input === 'quiz') {
        quizMode(subject);
      } else {
        console.log(`Appu is watching: Keep grinding! (${Math.round((new Date() - startTime) / 60000)} mins passed)`);
      }
    });
  });
}

