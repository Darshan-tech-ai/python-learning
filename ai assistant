  console.log('\n------------------------------------------------------');
  console.log(`📝 APPU ACTIVE RECALL QUIZ [${key.toUpperCase()}]:`);
  console.log(`Question: ${item.q}\n`);
  item.options.forEach(opt => console.log(`   ${opt}`));
  console.log('\nCorrect Answer: ' + item.ans);
  console.log('Explanation:    ' + item.exp);
  console.log('------------------------------------------------------\n');
}

function serveWebDashboard(port = 3333) {
  const publicDir = path.join(__dirname, 'public');
  const server = http.createServer((req, res) => {
    if (req.url === '/' || req.url === '/index.html') {
      const htmlPath = path.join(publicDir, 'index.html');
      if (fs.existsSync(htmlPath)) {
        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
        fs.createReadStream(htmlPath).pipe(res);
        return;
      }
    }

    if (req.url === '/api/status') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify(getScheduleStatus()));
      return;
    }

    if (req.url === '/api/schedule') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify(loadSchedule()));
      return;
    }

    if (req.url === '/api/quiz') {
      const all = [...QUIZZES.aiml, ...QUIZZES.dsa];
      const randomQ = all[Math.floor(Math.random() * all.length)];
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify(randomQ));
      return;
    }

    res.writeHead(404, { 'Content-Type': 'text/plain' });
    res.end('Not Found');
  });

  server.listen(port, () => {
    console.log('\n======================================================');
    console.log(`🐘 APPU LIVE DASHBOARD RUNNING AT:`);
    console.log(`👉 http://localhost:${port}`);
    console.log('======================================================\n');
  });
}

// Command dispatcher
const cmd = (process.argv[2] || '').toLowerCase();
const arg = process.argv[3];

switch (cmd) {
  case 'watch':
    watchMode();
    break;
  case 'study':
    studyMode(arg);
    break;
  case 'quiz':
    quizMode(arg);
    break;
  case 'serve':
    serveWebDashboard(arg ? parseInt(arg, 10) : 3333);
    break;
  case 'status':
  default:
    printStatus();
    break;
}


